# ============================================================
#  Maanvika Grills & Nets - Apache / LiteSpeed configuration
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# ------------------------------------------------------------
#  Canonical host: force HTTPS and drop the www prefix.
#  Search engines then see exactly one address for every page.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://maanvikasafetynetschennai.com/$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # / and /index.php are the same page: keep a single address.
    RewriteCond %{THE_REQUEST} "\s/index\.php[\s?]" [NC]
    RewriteRule ^index\.php$ / [R=301,L]
</IfModule>

# ------------------------------------------------------------
#  Retired URLs
#  The enquiry form used to redirect to /thank-you.php and post to
#  /form-to-email-contact.php. Both are gone - the thank-you message now
#  shows on the form page itself - so send any old link or bookmark to the
#  contact page instead of a 404.
# ------------------------------------------------------------
Redirect 301 /thank-you.php /contact.php
Redirect 301 /form-to-email-contact.php /contact.php

# ------------------------------------------------------------
#  Error pages
# ------------------------------------------------------------
ErrorDocument 404 /404.php

# ------------------------------------------------------------
#  Keep server-side and stray files out of the browser.
#  The enquiry form holds no credentials, but these patterns stop
#  editor backups, logs and any future config from being served.
# ------------------------------------------------------------
<FilesMatch "\.(env|ini|log|sh|bak|bak\d*|old|orig|sql|swp)$|^composer\.(json|lock)$">
    Require all denied
</FilesMatch>

# Local development helper only; the live server uses this file's rules instead.
<Files "router.php">
    Require all denied
</Files>

# Internal folders. Nothing in them is meant to be fetched over the web: the
# config holds the SMTP password, core holds the helpers, and actions holds the
# handler that the form posts to. PHP reads them from disk, so denying browser
# access costs nothing and keeps them out of reach if the server ever stops
# executing PHP (a bad deploy, a config slip) and serves them as plain text.
#
# actions/ is the one exception: the form has to be able to post to it.
RedirectMatch 404 ^/(config|core|data|partials|templates|tools)(/.*)?$

# The SMTP password lives in mail-config.php wherever it is installed.
<FilesMatch "^(mail-config|mail-config\.sample|mailer)\.php$">
    Require all denied
</FilesMatch>

# Page fragments pulled in by include; on their own they render a broken
# fragment or nothing at all. PHP includes read them from disk, so denying
# web access does not affect the pages that use them.
<FilesMatch "^(header|footer|side-bar|enquiry-form|gallery-data|service-photos|brand)\.php$">
    Require all denied
</FilesMatch>

# Left in place so a future "composer install" is protected from day one.
RedirectMatch 404 ^/vendor/.*$


# ------------------------------------------------------------
#  Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  Browser caching
#  Static assets are fingerprint-free, so a month is the safe
#  ceiling: long enough to help repeat visits, short enough that
#  a redesign reaches everyone without a hard refresh.
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"

    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"

    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # ------------------------------------------------------------
    #  Security headers
    # ------------------------------------------------------------
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------
#  Correct media types
# ------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp   .webp
    AddType image/svg+xml .svg
    AddType font/woff2   .woff2
    AddType application/manifest+json .webmanifest
</IfModule>
